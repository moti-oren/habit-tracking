{
  "name": "habit-tracker",
  "private": true,
  "version": "2.0.0",
  "description": "Daily and weekly habit tracker dashboard (Hebrew, RTL). Vanilla JS, ES modules, Vite and Tailwind CSS.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:css": "node scripts/check-tailwind-classes.mjs",
    "check:deps": "madge --circular --extensions js src",
    "verify": "npm run lint && npm run format:check && npm run check:deps && npm run check:css && npm test && npm run build && npm run build:single"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sinonjs/fake-timers": "^15.4.0",
    "autoprefixer": "10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "madge": "^8.0.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4.17",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
